{
    "name": "videomed/api",
    "description": "VideoMed backend API — Slim 4 + PHP-DI + Doctrine ORM 3 on PostgreSQL.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-pdo": "*",
        "slim/slim": "^4.12",
        "slim/psr7": "^1.6",
        "php-di/php-di": "^7.0",
        "php-di/slim-bridge": "^3.4",
        "doctrine/orm": "^3.2",
        "doctrine/dbal": "^4.0",
        "doctrine/migrations": "^3.7",
        "firebase/php-jwt": "^7.0",
        "vlucas/phpdotenv": "^5.6",
        "monolog/monolog": "^3.6",
        "ramsey/uuid": "^4.7",
        "predis/predis": "^2.2",
        "symfony/cache": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "start": "php -S localhost:8080 -t public",
        "test": "phpunit",
        "schema:preview": "php bin/doctrine.php orm:schema-tool:update --dump-sql",
        "schema:apply": "php bin/doctrine.php orm:schema-tool:update --force"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
