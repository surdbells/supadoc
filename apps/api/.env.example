APP_ENV=production
APP_DEBUG=false
APP_RELEASE=

DB_DRIVER=pdo_pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=videomed
DB_USER=videomed
DB_PASSWORD=
# Pin so DQL compiles offline without a DB connection (see ARCHITECTURE §12).
DB_SERVER_VERSION=16

# Must be at least 32 bytes — php-jwt v7 rejects shorter HS256 keys (login 500s).
# Generate: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=change-me-to-a-long-random-string-min-32-bytes
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX=videomed:

# Comma-separated origins allowed by CORS. Include every deployed frontend:
# the patient app plus the separately-deployed backoffice + doctor portals
# (each its own Cloudflare Pages domain). Dev ports: patient 4201, backoffice
# 4202, doctor 4204.
CORS_ALLOWED_ORIGINS=http://localhost:4201,http://localhost:4202,http://localhost:4204,https://app.dosthq.com,https://backoffice.dosthq.com,https://doctor.dosthq.com
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# Google sign-in (Firebase). The web SDK config lives in the frontend env; the
# backend only needs the project id to verify ID tokens against Google's keys.
FIREBASE_PROJECT_ID=

# Termii phone verification (SMS OTP). Blank API key => the OTP endpoints return
# 503 and no SMS is sent.
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com

# ZeptoMail transactional email. Blank token => emails are skipped (logged, not
# sent). FROM_ADDRESS must be on a domain verified in ZeptoMail. Use
# api.zeptomail.eu for the EU data centre.
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_FROM_ADDRESS=
ZEPTOMAIL_FROM_NAME=VideoMed
ZEPTOMAIL_BASE_URL=https://api.zeptomail.com

# Public URL of the patient web app, used in email links.
APP_WEB_URL=https://app.dosthq.com

# Agora video/audio (RTC). Both are 32-char hex from Agora Console. APP_ID is
# public (also shipped to the browser); APP_CERTIFICATE stays server-side only.
# Modes, by what's set:
#   - APP_ID blank                  => call endpoints return 503 (video off).
#   - APP_ID set, CERTIFICATE set   => secured mode: backend mints RTC tokens.
#     CERTIFICATE must be the *Primary* cert that is ENABLED in Console
#     (Project → Config → App Certificate). No quotes/spaces; don't swap the two
#     — a mismatch shows up client-side as "invalid token, authorized failed".
#   - APP_ID set, CERTIFICATE blank => App-ID-only mode: backend returns a null
#     token and the client joins token-less. INSECURE (anyone with the App ID
#     can join any channel) — testing only, and disable the certificate in the
#     Agora Console too. Do NOT use in production.
# Verify with: php bin/agora-check.php
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# TEMPORARY stopgap. A fixed token generated in the Agora Console + the channel it
# was minted for. When BOTH are set, the backend serves this token/channel for every
# call instead of minting per appointment — so ALL parties join the same room. Use
# only to keep calls working while a certificate issue is being resolved; a Console
# token is single-channel and expires in <=24h, so it must be regenerated regularly.
# Leave both blank for normal per-appointment minting. Verify a token with:
#   php bin/agora-verify-token.php '<token>'
AGORA_STATIC_TOKEN=
AGORA_STATIC_CHANNEL=

# Agora Cloud Recording (optional). Enable Cloud Recording in the Agora Console,
# then set the RESTful API Customer ID/Secret (Console → RESTful API) and a cloud
# storage target Agora uploads finished recordings to. Blank customer key/secret
# or bucket => the recording endpoints return 503 (recording simply unavailable).
# Recording only ever starts after the PATIENT grants recording consent.
# VENDOR/REGION are Agora's integer codes (e.g. vendor 1 = AWS S3); see
# https://docs.agora.io/en/cloud-recording/reference/rest-api/cloud_recording_api_start
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
AGORA_RECORDING_VENDOR=
AGORA_RECORDING_REGION=
AGORA_RECORDING_BUCKET=
AGORA_RECORDING_ACCESS_KEY=
AGORA_RECORDING_SECRET_KEY=

# AI clinical copilot (optional) — turns the consultation transcript into a DRAFT
# summary + SOAP + extractions for the clinician to review (never auto-recorded).
# Uses the Anthropic Messages API. Blank key => the copilot endpoints return 503;
# live transcription still works without it (it runs in the browser). Only the
# patient's AI-transcription consent enables any of this.
COPILOT_API_KEY=
COPILOT_MODEL=claude-sonnet-4-5
COPILOT_BASE_URL=https://api.anthropic.com

SENTRY_DSN=
