APP_ENV=production
APP_DEBUG=false
APP_RELEASE=

DB_DRIVER=pdo_pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=videomed
DB_USER=videomed
DB_PASSWORD=
# Pin so DQL compiles offline without a DB connection (see ARCHITECTURE §12).
DB_SERVER_VERSION=16

# Must be at least 32 bytes — php-jwt v7 rejects shorter HS256 keys (login 500s).
# Generate: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=change-me-to-a-long-random-string-min-32-bytes
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PREFIX=videomed:

CORS_ALLOWED_ORIGINS=http://localhost:4201,https://app.dosthq.com
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# Google sign-in (Firebase). The web SDK config lives in the frontend env; the
# backend only needs the project id to verify ID tokens against Google's keys.
FIREBASE_PROJECT_ID=

# Termii phone verification (SMS OTP). Blank API key => the OTP endpoints return
# 503 and no SMS is sent.
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com

# ZeptoMail transactional email. Blank token => emails are skipped (logged, not
# sent). FROM_ADDRESS must be on a domain verified in ZeptoMail. Use
# api.zeptomail.eu for the EU data centre.
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_FROM_ADDRESS=
ZEPTOMAIL_FROM_NAME=VideoMed
ZEPTOMAIL_BASE_URL=https://api.zeptomail.com

# Public URL of the patient web app, used in email links.
APP_WEB_URL=https://app.dosthq.com

# Agora video/audio (RTC). Blank => the call-token endpoint returns 503. The
# App ID also goes in the frontend env; the certificate stays server-side only.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

SENTRY_DSN=
