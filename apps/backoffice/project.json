{
  "name": "backoffice",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "bo",
  "sourceRoot": "apps/backoffice/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/backoffice",
        "browser": "apps/backoffice/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/backoffice/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/backoffice/public"
          },
          {
            "glob": "pdf.worker.min.mjs",
            "input": "node_modules/pdfjs-dist/legacy/build",
            "output": "pdfjs"
          },
          {
            "glob": "**/*",
            "input": "node_modules/pdfjs-dist/cmaps",
            "output": "pdfjs/cmaps"
          },
          {
            "glob": "**/*",
            "input": "node_modules/pdfjs-dist/standard_fonts",
            "output": "pdfjs/standard_fonts"
          },
          {
            "glob": "**/*",
            "input": "node_modules/pdfjs-dist/wasm",
            "output": "pdfjs/wasm",
            "ignore": ["quickjs-eval.*"]
          }
        ],
        "styles": [
          "node_modules/@fontsource-variable/lexend/wght.css",
          "node_modules/@fontsource/poppins/index.css",
          "apps/backoffice/src/styles.css"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/backoffice/src/environments/environment.ts",
              "with": "apps/backoffice/src/environments/environment.prod.ts"
            }
          ]
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "backoffice:build:production"
        },
        "development": {
          "buildTarget": "backoffice:build:development"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "backoffice:build",
        "staticFilePath": "dist/apps/backoffice/browser",
        "spa": true
      }
    }
  }
}
